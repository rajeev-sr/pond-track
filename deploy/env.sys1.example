# ─────────────────────────────────────────────────────────────────────────────
# Contour — .env for the mentor-provided host (stu79_sys1, 10.1.75.53).
#
#   cp deploy/env.sys1.example .env
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# Copy it to `.env` in the repository root -- docker compose reads that file
# automatically for `${VAR}` substitution in docker-compose.yml. It is NOT the
# same thing as the container environment: everything the app itself reads is
# already set in the compose file's `x-backend-env` anchor.
# ─────────────────────────────────────────────────────────────────────────────

# --- Host port mappings ------------------------------------------------------
# Only the five ports in the allocation table reach the outside world. Anything
# bound to another port is reachable from the host itself and nowhere else, so
# the mapping below is deliberate, not arbitrary:
#
#   3273  frontend   THE public URL. nginx serves the SPA and reverse-proxies
#                    /api/, /ws/, /docs and /tiles/ to the other containers, so
#                    a visitor needs this port and no other.
#   4273  api        published as well, so the Swagger UI at :4273/docs can be
#                    shown directly without going through the SPA's origin.
#   5273  titiler    published for debugging a tile by hand. The map does not
#                    need it -- the browser asks the frontend for /tiles/... and
#                    nginx forwards that over the internal network.
#
# Postgres and Redis get the remaining two numbers but are bound to 127.0.0.1
# on purpose. Compose interpolates the whole left-hand side of the mapping, so
# `127.0.0.1:6273` expands to `127.0.0.1:6273:5432` -- reachable with `psql` in
# an SSH session, unreachable from the network. A database open to the internet
# with a password from an example file is the one mistake here worth ruling out
# structurally rather than remembering not to make.
FRONTEND_HOST_PORT=3273
API_HOST_PORT=4273
TITILER_HOST_PORT=5273
POSTGRES_HOST_PORT=127.0.0.1:6273
REDIS_HOST_PORT=127.0.0.1:7273

# --- Container user ----------------------------------------------------------
# The api and worker containers run as this uid:gid so the files they write into
# the bind-mounted ./data are owned by the account that ran `docker compose`.
# The compose default is 1000, which is right on most single-user machines and
# wrong on a shared teaching host -- and the symptom is not a permission error at
# startup but a 500 from /terrain/derivatives much later, when something first
# tries to write a COG. Append the real values instead of trusting the default:
#
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
HOST_UID=1000
HOST_GID=1000

# --- Database ----------------------------------------------------------------
# Change this. It is bound to localhost, so the exposure is limited to accounts
# on the same host -- which on a shared machine is not nobody.
POSTGRES_DB=contour
POSTGRES_USER=contour
POSTGRES_PASSWORD=change_me_before_deploying

# --- Behaviour ---------------------------------------------------------------
ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
DEMO_MODE=false
MAX_AOI_KM2=100
DEFAULT_DEM_SOURCE=COP30
AOI_BUFFER_M=500
SUITABILITY_ALPHA=0.6

# --- CORS --------------------------------------------------------------------
# The SPA calls the API at a relative /api/v1, same origin, so the browser never
# preflights and this list is irrelevant to normal use. It matters only for
# calling :4273 directly -- from the Swagger UI, or from a page served on 3273.
CORS_ORIGINS=http://10.1.75.53:3273,http://10.1.75.53:4273

# --- Storage / tiles ---------------------------------------------------------
# Both are already set for the containers by docker-compose.yml. They are here
# only so a `uvicorn` run on the host from an SSH session finds the same tiler.
TITILER_ENDPOINT=http://localhost:5273
TILER_STORE_PATH=/data/cache
