# ─────────────────────────────────────────────────────────────────────────────
# Contour — configuration.  Copy to .env and fill in.   cp .env.example .env
# Startup FAILS FAST with a clear message if a required value is missing.
# ─────────────────────────────────────────────────────────────────────────────

# --- Required for Ring 1 (see docs/IMPLEMENTATION_PLAN.md M0-1) -------------
# portal.opentopography.org — free, instant. Blocks M1 (DEM acquisition).
OPENTOPOGRAPHY_API_KEY=
# data.gov.in — free, instant. IMD district rainfall.
DATA_GOV_IN_API_KEY=

# --- Optional now, required for Ring 2 (apply in M0, used in M8/M9) ---------
BHUVAN_TOKEN=
BHOONIDHI_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- Database ---------------------------------------------------------------
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=contour
POSTGRES_USER=contour
POSTGRES_PASSWORD=contour_dev_only_change_me

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Storage / tiles -------------------------------------------------------
COG_STORE_PATH=/data/cache
TITILER_ENDPOINT=http://titiler:8000

# --- Behaviour ------------------------------------------------------------
ENV=development                  # development | production
LOG_LEVEL=INFO
LOG_JSON=true
DEMO_MODE=false                  # true -> serve warmed fixtures, no network
MAX_AOI_KM2=100
DEFAULT_DEM_SOURCE=COP30         # COP30 | SRTMGL1 | NASADEM | AW3D30
AOI_BUFFER_M=500
SUITABILITY_ALPHA=0.6            # 1.0 = pure AHP, no ML
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_HOST_PORT=8000
REDIS_HOST_PORT=16379
POSTGRES_HOST_PORT=15432
