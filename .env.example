# ─────────────────────────────────────────────────────────────────────────────
# Contour — configuration.  Copy to .env and fill in.   cp .env.example .env
# Startup FAILS FAST with a clear message if a required value is missing.
# ─────────────────────────────────────────────────────────────────────────────

# --- THERE ARE NO API KEYS. NONE. -------------------------------------------
# Every data source this project uses is open and keyless, by design:
#
#   elevation    the contour map you upload, and Copernicus GLO-30 from the
#                AWS Open Data bucket -- no key, no registration, no quota
#   land cover   ESA WorldCover 10 m (open S3), CC-BY 4.0
#   soil         ISRIC SoilGrids v2.0 REST, CC-BY 4.0
#   rainfall     Open-Meteo ERA5-Land and NASA POWER -- two independent
#                30-year reanalyses, cross-checked against each other
#   boundaries   SHRUG (Harvard Dataverse, CC0) + geoBoundaries (ODbL)
#   features     OpenStreetMap via Overpass (ODbL)
#
# This file once carried five empty credential fields for ISRO and IMD sources
# planned in later phases. No code ever read them, and each capability already
# had a keyless equivalent in use -- so they made `/health/ready` report five
# "missing: KEY" lines that looked like problems while describing features that
# do not exist. They are gone. There is nothing here to obtain, apply for, or
# wait on.

# --- Where the services live ------------------------------------------------
# LEAVE THE FIRST THREE COMMENTED OUT unless you know you want them.
#
# `postgis`, `redis` and `/data` are names that only resolve *inside* the compose
# network. `docker-compose.yml` already sets all three for the containers, so
# this file does not need to -- and when it does set them, a host-run
# `uvicorn app.main:app` inherits them and cannot reach any of the three. That
# is not a hypothetical: it produces "Temporary failure in name resolution" for
# Postgres and Redis, two "cache write failed" warnings, and a 500 from
# /terrain/derivatives trying to mkdir `/data`. The code's own defaults point at
# a reachable localhost and at `<repo>/data/cache`, which work in both places.
#
# Uncomment these ONLY to point the app at a Postgres/Redis/store somewhere else.
# POSTGRES_HOST=postgis
# POSTGRES_PORT=5432
# REDIS_URL=redis://redis:6379/0
# COG_STORE_PATH=/data/cache

# --- Database ---------------------------------------------------------------
POSTGRES_DB=contour
POSTGRES_USER=contour
POSTGRES_PASSWORD=contour_dev_only_change_me

# --- Storage / tiles -------------------------------------------------------
# COG_STORE_PATH is above, with the other in-cluster names. TiTiler is reachable
# from the host on its published port, which is not the port it listens on inside
# the network -- compose maps 8001 -> 8000.
TITILER_ENDPOINT=http://localhost:8001

# Where TiTiler sees the raster store. A tile URL carries the COG's path and
# TiTiler opens it with its own filesystem, so it must be TiTiler's path -- which
# is not ours when the API runs on the host. Leave this alone unless you moved
# the tiler's mount; the default matches docker-compose.yml.
TILER_STORE_PATH=/data/cache

# --- Host port mappings ----------------------------------------------------
# Only where each service is reachable *from the host*. Nothing inside the stack
# uses these: the containers talk to each other on their own network by service
# name, so moving a host port breaks nothing.
#
# Postgres and Redis deliberately do NOT default to 5432 and 6379. A developer
# machine very often has one of those already running, and the clash does not
# fail loudly: `docker compose up -d` reports success, the container starts and
# answers `redis-cli ping` from inside, but Docker leaves it attached to no
# network -- so the API cannot resolve `redis` at all and the only symptom is
# `/health/ready` reporting "degraded" with a DNS error. That is a miserable
# thing to debug, and it happened on the first fresh-directory install this
# guide was tested against.
API_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
TITILER_HOST_PORT=8001

# --- Behaviour ------------------------------------------------------------
ENV=development                  # development | production
LOG_LEVEL=INFO
LOG_JSON=true
DEMO_MODE=false                  # true -> serve warmed fixtures, no network
MAX_AOI_KM2=100
DEFAULT_DEM_SOURCE=COP30         # COP30 | SRTMGL1 | NASADEM | AW3D30
AOI_BUFFER_M=500
SUITABILITY_ALPHA=0.6            # 1.0 = pure AHP, no ML
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
