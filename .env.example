# ─────────────────────────────────────────────────────────────────────────────
# Contour — configuration.  Copy to .env and fill in.   cp .env.example .env
# Startup FAILS FAST with a clear message if a required value is missing.
# ─────────────────────────────────────────────────────────────────────────────

# --- NO CREDENTIALS ARE REQUIRED TO RUN THE MANDATORY PIPELINE -------------
# Elevation comes from the Copernicus GLO-30 AWS Open Data bucket: no key, no
# registration, no quota (HLD 4.2 A1). Everything below is an optional
# enrichment -- if it is blank, that one layer degrades and the pipeline
# continues. /api/v1/health/ready reports exactly what is and is not available.

# Optional: official IMD district rainfall alongside the gridded record (M4).
DATA_GOV_IN_API_KEY=
# Optional: only for SRTM / NASADEM / AW3D30 variety. COP30 needs no key.
OPENTOPOGRAPHY_API_KEY=

# --- Optional, used by Ring 2 (apply in M0, used in M8/M9) ------------------
BHUVAN_TOKEN=
BHOONIDHI_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- Database ---------------------------------------------------------------
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=contour
POSTGRES_USER=contour
POSTGRES_PASSWORD=contour_dev_only_change_me

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Storage / tiles -------------------------------------------------------
COG_STORE_PATH=/data/cache
TITILER_ENDPOINT=http://titiler:8000

# --- Host port mappings ----------------------------------------------------
# Change any of these if the default clashes with something already running
# locally (a system Redis or Postgres is the usual culprit).
API_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
TITILER_HOST_PORT=8001

# --- Behaviour ------------------------------------------------------------
ENV=development                  # development | production
LOG_LEVEL=INFO
LOG_JSON=true
DEMO_MODE=false                  # true -> serve warmed fixtures, no network
MAX_AOI_KM2=100
DEFAULT_DEM_SOURCE=COP30         # COP30 | SRTMGL1 | NASADEM | AW3D30
AOI_BUFFER_M=500
SUITABILITY_ALPHA=0.6            # 1.0 = pure AHP, no ML
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
